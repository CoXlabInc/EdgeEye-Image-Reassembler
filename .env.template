# EdgeEye Post Processor Configuration Template
# Copy this file to .env and adjust the values accordingly.

# Chirpstack v4 MQTT Broker Address (e.g., tcp://mosquitto:1883)
MQTT_URL=tcp://mosquitto:1883
# MQTT authentication (leave empty if not required)
MQTT_USER=
MQTT_PASS=

# Redis Context Storage URL (use redis://redis:6379 for the internal service)
REDIS_URL=redis://redis:6379

# Timezone and Locale (e.g., Asia/Seoul, ko_KR.UTF-8)
TZ=UTC
LANG=en_US.UTF-8

# Filter by Device Profile ID (REQUIRED unless DEVICE_PROFILES is set)
# You can find this ID in the Chirpstack Device Profile page.
DEVICE_PROFILE_ID=

# Serve several device profiles, each with its own virtual sessions per image
# (0 = single session, up to 2), e.g. PROFILE_ID_A:0,PROFILE_ID_B:2
# When set, it replaces DEVICE_PROFILE_ID, MULTI_SESSION and NUM_SESSIONS.
DEVICE_PROFILES=

# HTTP Image Upload Configuration (Optional)
# UPLOAD_URL: The endpoint where the reassembled image will be POSTed.
UPLOAD_URL=
# UPLOAD_HEADERS: JSON string of headers (e.g., {"Authorization": "Bearer ...", "X-Custom": "value"})
UPLOAD_HEADERS=
# DET_UPLOAD_MODE: How to upload detection data (1=with snap, 2=det first+with snap, 3=det first+snap alone)
DET_UPLOAD_MODE=2
# UPLOAD_OVERLAY: Comma-separated overlays for upload snap (timestamp,bbox,none)
UPLOAD_OVERLAY=timestamp,bbox

# SAVE_DIR: Directory name for saving completed images.
# Host path: ./{SAVE_DIR}, Container path: /data/{SAVE_DIR}
# Leave empty to disable saving.
SAVE_DIR=

# Per-application upload configuration (JSON object: app_id → config)
# Each entry can override url, headers, and save_dir per application.
# Falls back to UPLOAD_URL, UPLOAD_HEADERS, SAVE_DIR for missing fields.
# APP_UPLOAD={"app1":{"url":"https://api1.example.com/upload","headers":{"X-API-Key":"key1"},"save_dir":"saved_app1"},"app2":{"url":"https://api2.example.com/upload","save_dir":"saved_app2"}}
APP_UPLOAD=

# ===== Multi-session uplink (optional) =====
# MULTI_SESSION: 1 to enable. For each image the reassembler issues extra LoRaWAN
# sessions (DevAddr + keys), hands them to the camera (fPort 5) and decodes the
# frames sent on them itself from the gateway bridge MQTT topics. The sessions
# are never registered in ChirpStack, so ChirpStack never answers them.
MULTI_SESSION=0
# Virtual sessions per camera (firmware supports up to 2)
NUM_SESSIONS=2
# Gateway bridge MQTT topic prefix(es), comma-separated (the region's topic prefix)
GATEWAY_TOPIC_PREFIX=kr920
# DevAddr prefix for the virtual sessions. It must lie outside the network's NetID
# range, and the gateway bridge must not filter uplinks by NetID.
SESSION_DEVADDR_PREFIX=fe000000/7
